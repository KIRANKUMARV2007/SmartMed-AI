# SmartMed AI Backend Environment Configuration Template
# Copy this file to .env and provide your actual MongoDB connection string.
# DO NOT commit real credentials or production secrets.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smartmed
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional AI LLM Provider Keys (System operates with deterministic clinical rationale if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
